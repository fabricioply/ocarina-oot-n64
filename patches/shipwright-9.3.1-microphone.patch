diff --git a/soh/CMakeLists.txt b/soh/CMakeLists.txt
index f356d214..2618075d 100644
--- a/soh/CMakeLists.txt
+++ b/soh/CMakeLists.txt
@@ -629,7 +629,7 @@ if (CMAKE_SYSTEM_NAME STREQUAL "Windows")
     find_package(Opus CONFIG REQUIRED)
     link_libraries(Opus::opus)
     find_package(OpusFile CONFIG REQUIRED)
-    link_libraries(OpusFile::opusfile CONFIG REQUIRED)
+    link_libraries(OpusFile::opusfile)
     if(SOH_WINDOWS_64BIT)
         set(ADDITIONAL_LIBRARY_DEPENDENCIES
             "libultraship;"
@@ -803,3 +803,30 @@ wut_create_wuhb(${PROJECT_NAME}
 INSTALL(FILES ${CMAKE_CURRENT_BINARY_DIR}/soh.rpx ${CMAKE_CURRENT_BINARY_DIR}/soh.wuhb DESTINATION . COMPONENT ship)
 
 endif()
+
+# Local N64 microphone mod; kept separate from the completed OoT3D mods.
+if(WIN32)
+    set(OCARINA_N64_SOURCE_ROOT "${CMAKE_SOURCE_DIR}/../ocarina-oot-n64" CACHE PATH "Local microphone mod")
+    add_subdirectory("${OCARINA_N64_SOURCE_ROOT}/shared/real_instrument" "${CMAKE_BINARY_DIR}/ocarina_core" EXCLUDE_FROM_ALL)
+    target_sources(${PROJECT_NAME} PRIVATE "${OCARINA_N64_SOURCE_ROOT}/src/soh_microphone.cpp")
+    target_include_directories(${PROJECT_NAME} PRIVATE "${OCARINA_N64_SOURCE_ROOT}/src")
+    target_compile_definitions(${PROJECT_NAME} PRIVATE OCARINA_N64_MIC=1)
+    target_link_libraries(${PROJECT_NAME} PRIVATE real_instrument_game_microphone)
+endif()
+
+# clang-cl interprets upstream /Wall as -Weverything, including every imported
+# game/header. Keep normal actionable warnings for this Windows clang build.
+if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND MSVC)
+    target_compile_options(soh PRIVATE -Wno-everything -Wall -Wextra)
+endif()
+
+if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND MSVC)
+    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" --print-resource-dir OUTPUT_VARIABLE OC_CLANG_RESOURCE OUTPUT_STRIP_TRAILING_WHITESPACE)
+    target_link_libraries(soh PRIVATE "${OC_CLANG_RESOURCE}/lib/windows/clang_rt.builtins-x86_64.lib")
+endif()
+if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND MSVC)
+    target_link_options(soh PRIVATE /opt:lldlto=1 /opt:lldltojobs=2 "/lldltocache:${CMAKE_BINARY_DIR}/thinlto-cache")
+endif()
+if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND MSVC)
+    target_link_options(soh PRIVATE /DEBUG:NONE)
+endif()
